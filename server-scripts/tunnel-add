#!/usr/bin/env bash
# Point a hostname at a local port through the Cloudflare tunnel.
#
# A wrapper now. The work happens in the panel's route module, which the panel
# itself also imports — so the two cannot disagree. They used to: this script
# and `tunnel_add_route` inside `project` were separate implementations of the
# same job, and neither verified the result. A publish that half-worked left a
# live DNS record pointing at an ingress rule that no longer matched.
#
# The interface is unchanged, so `project` and anything else calling it keep
# working: tunnel-add <name> <port>
set -euo pipefail

NAME=${1:-}; PORT=${2:-}
if [ -z "$NAME" ] || [ -z "$PORT" ]; then
	echo "Usage: tunnel-add <name> <port>" >&2
	exit 1
fi

APP="${BITPANEL_APP:-$HOME/apps/bitroot-panel}"
[ -d "$APP" ] || { echo "!! panel not found at $APP" >&2; exit 1; }
[ -f "$APP/scripts/route.mjs" ] || {
	echo "!! $APP/scripts/route.mjs is missing — run 'npm run build' in the panel" >&2
	exit 1
}

# The module reads CF_API_TOKEN to find which zone owns the hostname, and
# DOMAIN_SUFFIX to build it.
set -a; . "$APP/.env" 2>/dev/null || true; set +a
DOMAIN_SUFFIX="${DOMAIN_SUFFIX:-example.com}"
HOST="${NAME}.${DOMAIN_SUFFIX}"

node "$APP/scripts/route.mjs" publish "$HOST" "$PORT"

# Kept for the Residue page, which offers to clean up records the panel created
# when a service is removed. Recorded only after a successful publish.
mkdir -p "$HOME/.config/bitpanel"
grep -qxF "$HOST" "$HOME/.config/bitpanel/dns-created.txt" 2>/dev/null \
	|| echo "$HOST" >> "$HOME/.config/bitpanel/dns-created.txt"
