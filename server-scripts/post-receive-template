#!/usr/bin/env sh
# Deploys on git push: checkout -> npm install -> (npm run build) -> pm2 restart.
# Apps with a "build" script get a full dependency install + build; others get
# a lean production install. Running apps are restarted in place (env preserved).
set -e
REPO="$PWD"
NAME=$(basename "$REPO" .git)
WORK="$HOME/apps/$NAME"
PORT=$(cat "$REPO/PORT" 2>/dev/null || echo 3000)
mkdir -p "$WORK"
while read old new ref; do
  branch=${ref#refs/heads/}
  git --work-tree="$WORK" --git-dir="$REPO" checkout -f "$branch"
done
cd "$WORK"
unset GIT_DIR

HAS_BUILD=0
HAS_START=0
if [ -f package.json ]; then
  node -e "const s=require('./package.json').scripts||{}; process.exit(s.build?0:1)" && HAS_BUILD=1 || true
  node -e "const s=require('./package.json').scripts||{}; process.exit(s.start?0:1)" && HAS_START=1 || true
  echo "==> installing dependencies"
  if [ "$HAS_BUILD" = 1 ]; then
    # build tools live in devDependencies; never let an inherited
    # NODE_ENV=production omit them
    env -u NODE_ENV npm install --include=dev --no-audit --no-fund
  else
    npm install --omit=dev --no-audit --no-fund
  fi
fi

# The panel ships the scripts it drives - project, deploy-webhook, tunnel-add -
# but they live in ~/bin, outside the deployed tree, so a push updated the app
# and left them behind. That failure is silent: deploy-webhook kept running an
# older copy that had never heard of an endpoint the panel had just started
# advertising, and deliveries 404'd with nothing obviously wrong.
# Record what was deployed. The work tree is not a git repository - the hook
# checks files out with --work-tree while the git data stays in the bare repo -
# so `git describe` run inside it fails outright, and the panel could only
# report "untagged build" no matter what was pushed.
if [ "$NAME" = "bitroot-panel" ]; then
  {
    echo "ref=$(git --git-dir="$REPO" describe --tags --always 2>/dev/null || echo unknown)"
    echo "commit=$(git --git-dir="$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "installed=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$WORK/.bitpanel-version"
fi

if [ "$NAME" = "bitroot-panel" ] && [ -d server-scripts ]; then
  echo "==> syncing ~/bin scripts"
  mkdir -p "$HOME/bin"
  changed=""
  for f in server-scripts/*; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    # Two rules, because either alone lets something through. The shebang test
    # keeps out data files - an extension blocklist had let pocketbase-index.html
    # in, chmod +x and all. The name test keeps out templates, which have a
    # shebang but are not meant to be run from PATH.
    case "$base" in *-template|*.conf) continue ;; esac
    head -c 2 "$f" | grep -q '^#!' || continue
    if ! cmp -s "$f" "$HOME/bin/$base"; then
      cp "$f" "$HOME/bin/$base" && chmod +x "$HOME/bin/$base"
      changed="$changed $base"
    fi
  done
  if [ -n "$changed" ]; then
    echo "    updated:$changed"
    # A script that runs as a service needs restarting to pick up its own new
    # copy; the rest are invoked fresh each time and do not.
    case "$changed" in
      *deploy-webhook*) pm2 restart deploy-webhook >/dev/null 2>&1 && echo "    restarted deploy-webhook" ;;
    esac
  else
    echo "    already current"
  fi
fi

if [ "$HAS_BUILD" = 1 ]; then
  echo "==> building"
  NODE_OPTIONS=--max-old-space-size=2048 npm run build
fi

if pm2 describe "$NAME" >/dev/null 2>&1; then
  echo "==> restarting $NAME"
  pm2 restart "$NAME" --update-env
elif [ "$HAS_START" = 1 ]; then
  echo "==> starting via npm start (PORT=$PORT)"
  PORT=$PORT pm2 start npm --name "$NAME" -- start
elif [ -f index.js ]; then
  echo "==> starting index.js (PORT=$PORT)"
  PORT=$PORT pm2 start index.js --name "$NAME"
else
  echo "==> no start script or index.js found; nothing started"
fi
pm2 save >/dev/null 2>&1 || true
echo "==> deployed '$NAME' on port $PORT"
