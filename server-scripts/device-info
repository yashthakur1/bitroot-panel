#!/usr/bin/env bash
# device-info — Display structured device information

G='\033[0;32m'  # green
C='\033[0;36m'  # cyan
Y='\033[1;33m'  # yellow
W='\033[1;37m'  # white
D='\033[0;90m'  # dim
R='\033[0m'     # reset
B='\033[1m'     # bold

# --- Gather data ---

# Device
MODEL=$(getprop ro.product.model)
BRAND=$(getprop ro.product.brand)
DEVICE=$(getprop ro.product.device)
SERIAL=$(getprop ro.serialno)
ANDROID_VER=$(getprop ro.build.version.release)
BUILD_ID=$(getprop ro.build.display.id)
KERNEL=$(uname -r)

# CPU
CHIPSET=$(getprop ro.board.platform | tr '[:lower:]' '[:upper:]')
HARDWARE=$(grep 'Hardware' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | xargs)
CPU_CORES=$(nproc)
ARCH=$(uname -m)

# Memory
MEM_TOTAL=$(awk '/MemTotal/ {printf "%.1f GB", $2/1024/1024}' /proc/meminfo)
MEM_AVAIL=$(awk '/MemAvailable/ {printf "%.1f GB", $2/1024/1024}' /proc/meminfo)
MEM_USED=$(awk '/MemTotal/ {t=$2} /MemAvailable/ {printf "%.1f GB", (t-$2)/1024/1024}' /proc/meminfo)

# Storage
STORAGE_LINE=$(df -h /data 2>/dev/null | tail -1)
STOR_TOTAL=$(echo "$STORAGE_LINE" | awk '{print $2}')
STOR_USED=$(echo "$STORAGE_LINE" | awk '{print $3}')
STOR_FREE=$(echo "$STORAGE_LINE" | awk '{print $4}')
STOR_PCT=$(echo "$STORAGE_LINE" | awk '{print $5}')

# Network
WIFI_IP=$(ip addr show wlan0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1)
WIFI_MAC=$(ip link show wlan0 2>/dev/null | awk '/ether/ {print $2}')
WIFI_IPV6=$(ip addr show wlan0 2>/dev/null | awk '/inet6.*global/ {print $2}' | head -1)
GATEWAY=$(ip route 2>/dev/null | awk '/default/ {print $3}' | head -1)
DNS1=$(getprop net.dns1 2>/dev/null)
DNS2=$(getprop net.dns2 2>/dev/null)

# Bluetooth
BT_NAME=$(getprop net.bt.name 2>/dev/null)
BT_MAC=$(getprop ro.boot.btmacaddr 2>/dev/null)
[ -z "$BT_MAC" ] && BT_MAC=$(cat /sys/class/bluetooth/hci0/address 2>/dev/null)
[ -z "$BT_MAC" ] && BT_MAC="N/A"

# Cellular
SIM_OP=$(getprop gsm.sim.operator.alpha 2>/dev/null)
NET_TYPE=$(getprop gsm.network.type 2>/dev/null)

# Uptime
UPTIME=$(uptime | sed 's/.*up /up /' | sed 's/,  load.*//')

# Termux
TERMUX_VER=$(dpkg -s termux-tools 2>/dev/null | awk '/Version/ {print $2}')
NODE_VER=$(node -v 2>/dev/null)
PM2_PROCS=$(pm2 jlist 2>/dev/null | node -e "try{var d=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));var on=d.filter(p=>p.pm2_env.status==='online').length;console.log(on+'/'+d.length)}catch(e){console.log('N/A')}" 2>/dev/null)

# --- Display ---

echo ""
printf "${C}╔══════════════════════════════════════════════════╗${R}\n"
printf "${C}║${W}${B}           BITROOT DEVICE INFO                    ${C}║${R}\n"
printf "${C}╚══════════════════════════════════════════════════╝${R}\n"
echo ""

printf "${Y}  DEVICE${R}\n"
printf "${D}  ──────────────────────────────────────────────${R}\n"
printf "  ${G}Model     ${D}:${R}  %s\n" "$BRAND $MODEL"
printf "  ${G}Codename  ${D}:${R}  %s\n" "$DEVICE"
printf "  ${G}Android   ${D}:${R}  %s\n" "$ANDROID_VER"
printf "  ${G}Build     ${D}:${R}  %s\n" "$BUILD_ID"
printf "  ${G}Kernel    ${D}:${R}  %s\n" "$KERNEL"
[ -n "$SERIAL" ] && printf "  ${G}Serial    ${D}:${R}  %s\n" "$SERIAL"
printf "  ${G}Uptime    ${D}:${R}  %s\n" "$UPTIME"
echo ""

printf "${Y}  CPU${R}\n"
printf "${D}  ──────────────────────────────────────────────${R}\n"
printf "  ${G}Chipset   ${D}:${R}  %s\n" "${HARDWARE:-$CHIPSET}"
printf "  ${G}Platform  ${D}:${R}  %s\n" "$CHIPSET"
printf "  ${G}Cores     ${D}:${R}  %s\n" "$CPU_CORES"
printf "  ${G}Arch      ${D}:${R}  %s\n" "$ARCH"
echo ""

printf "${Y}  MEMORY${R}\n"
printf "${D}  ──────────────────────────────────────────────${R}\n"
printf "  ${G}Total     ${D}:${R}  %s\n" "$MEM_TOTAL"
printf "  ${G}Used      ${D}:${R}  %s\n" "$MEM_USED"
printf "  ${G}Available ${D}:${R}  %s\n" "$MEM_AVAIL"
echo ""

printf "${Y}  STORAGE${R}\n"
printf "${D}  ──────────────────────────────────────────────${R}\n"
printf "  ${G}Total     ${D}:${R}  %s\n" "$STOR_TOTAL"
printf "  ${G}Used      ${D}:${R}  %s (%s)\n" "$STOR_USED" "$STOR_PCT"
printf "  ${G}Free      ${D}:${R}  %s\n" "$STOR_FREE"
echo ""

printf "${Y}  NETWORK${R}\n"
printf "${D}  ──────────────────────────────────────────────${R}\n"
printf "  ${G}WiFi IP   ${D}:${R}  %s\n" "${WIFI_IP:-N/A}"
[ -n "$WIFI_IPV6" ] && printf "  ${G}IPv6      ${D}:${R}  %s\n" "$WIFI_IPV6"
printf "  ${G}WiFi MAC  ${D}:${R}  %s\n" "${WIFI_MAC:-N/A}"
printf "  ${G}Gateway   ${D}:${R}  %s\n" "${GATEWAY:-N/A}"
[ -n "$DNS1" ] && printf "  ${G}DNS       ${D}:${R}  %s\n" "$DNS1"
[ -n "$DNS2" ] && printf "  ${G}DNS 2     ${D}:${R}  %s\n" "$DNS2"
echo ""

printf "${Y}  BLUETOOTH${R}\n"
printf "${D}  ──────────────────────────────────────────────${R}\n"
printf "  ${G}Name      ${D}:${R}  %s\n" "${BT_NAME:-N/A}"
printf "  ${G}MAC       ${D}:${R}  %s\n" "$BT_MAC"
echo ""

if [ -n "$SIM_OP" ]; then
printf "${Y}  CELLULAR${R}\n"
printf "${D}  ──────────────────────────────────────────────${R}\n"
printf "  ${G}Carrier   ${D}:${R}  %s\n" "$SIM_OP"
printf "  ${G}Network   ${D}:${R}  %s\n" "$NET_TYPE"
echo ""
fi

printf "${Y}  TERMUX${R}\n"
printf "${D}  ──────────────────────────────────────────────${R}\n"
[ -n "$TERMUX_VER" ] && printf "  ${G}Version   ${D}:${R}  %s\n" "$TERMUX_VER"
[ -n "$NODE_VER" ] && printf "  ${G}Node.js   ${D}:${R}  %s\n" "$NODE_VER"
printf "  ${G}PM2       ${D}:${R}  %s processes\n" "${PM2_PROCS:-N/A}"
printf "  ${G}Shell     ${D}:${R}  %s\n" "$SHELL"
echo ""
