#!/usr/bin/env bash
# Remove a hostname's route: the ingress entry and the DNS record together.
#
# A wrapper around the panel's route module, for the same reason as tunnel-add.
# Removing something that is not there is success, not an error — a retry after
# a partial failure must not report a problem.
set -euo pipefail

NAME=${1:-}
[ -n "$NAME" ] || { echo "Usage: tunnel-remove <name>" >&2; exit 1; }

APP="${BITPANEL_APP:-$HOME/apps/bitroot-panel}"
[ -d "$APP" ] || { echo "!! panel not found at $APP" >&2; exit 1; }
[ -f "$APP/scripts/route.mjs" ] || {
	echo "!! $APP/scripts/route.mjs is missing — run 'npm run build' in the panel" >&2
	exit 1
}

set -a; . "$APP/.env" 2>/dev/null || true; set +a
DOMAIN_SUFFIX="${DOMAIN_SUFFIX:-example.com}"
# Accept either a bare name or a full hostname, since both get typed.
case "$NAME" in
	*.*) HOST="$NAME" ;;
	*)   HOST="${NAME}.${DOMAIN_SUFFIX}" ;;
esac

node "$APP/scripts/route.mjs" unpublish "$HOST"

if [ -f "$HOME/.config/bitpanel/dns-created.txt" ]; then
	grep -vxF "$HOST" "$HOME/.config/bitpanel/dns-created.txt" > "$HOME/.config/bitpanel/dns-created.tmp" 2>/dev/null || true
	mv "$HOME/.config/bitpanel/dns-created.tmp" "$HOME/.config/bitpanel/dns-created.txt"
fi
