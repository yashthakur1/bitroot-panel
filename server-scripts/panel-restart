#!/usr/bin/env sh
# Restart the panel with the current contents of .env.
#
# `pm2 restart` alone restores the environment pm2 captured when the process
# first started, and --update-env copies the environment of whatever shell ran
# it. Neither reads .env, so a value edited a moment ago stays invisible - the
# blank the installer wrote outlives every later edit.
#
# The obvious fix, `set -a; . .env`, is worse than it looks: .env is not a shell
# script. A value containing a space runs as a command
# (NEXT_PUBLIC_ADMIN_NAME=Yash Thakur -> "Thakur: command not found"), and the
# variable is silently truncated at the space. Values with quotes, $ or
# backticks are worse. So the file is parsed, not executed.
set -e

APP="${BITPANEL_APP:-$HOME/apps/bitroot-panel}"
ENV_FILE="$APP/.env"
NAME="${BITPANEL_PM2_NAME:-bitroot-panel}"

[ -f "$ENV_FILE" ] || { echo "no .env at $ENV_FILE" >&2; exit 1; }

# `|| [ -n "$line" ]` so a final line without a trailing newline is not dropped.
while IFS= read -r line || [ -n "$line" ]; do
	case "$line" in
		''|'#'*) continue ;;
		*=*) ;;
		*) continue ;;
	esac
	key=${line%%=*}
	# Keys are shell-safe by construction; anything else is not ours to export.
	case "$key" in
		''|*[!A-Za-z0-9_]*) continue ;;
	esac
	# Quoted, so spaces and globs in the value survive intact.
	export "$key=${line#*=}"
done < "$ENV_FILE"

pm2 restart "$NAME" --update-env
